{
  "audio": "/tmp/test_speech.wav",
  "runs": 3,
  "pipelines": [
    {
      "name": "whisper -> astra-pro",
      "action": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY",
                 "model": "openai/gpt-6-astra-pro", "extra": {"reasoning_effort": "minimal"}}
    },
    {
      "name": "whisper -> gemini-3.8-flash",
      "action": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY",
                 "model": "google/gemini-3.8-flash", "extra": {"reasoning_effort": "minimal"}}
    },
    {
      "name": "whisper -> deepseek-v4-flash-vision",
      "action": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY",
                 "model": "deepseek/deepseek-v4-flash-vision-exp", "extra": {"reasoning_effort": "low"}}
    },
    {
      "name": "whisper -> claude-opus-5",
      "action": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY",
                 "model": "anthropic/claude-opus-5", "extra": {"reasoning_effort": "minimal"}}
    },
    {
      "name": "omni muse-spark-1.3",
      "omni": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY",
               "model": "meta/muse-spark-1.3", "extra": {"reasoning_effort": "minimal"}}
    },
    {
      "name": "omni gemini-3.8-flash",
      "omni": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY",
               "model": "google/gemini-3.8-flash", "extra": {"reasoning_effort": "minimal"}}
    }
  ]
}
