# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelle
ASR_MODEL=meta/muse-spark-1.3  # contributor-Variante ist privacy-blockiert
ACTION_MODEL=deepseek/deepseek-v4-flash-vision-exp

# Audio-Device (leer = Auto-Detect; z. B. "Elgato Wave Neo" oder Index)
AUDIO_DEVICE=

# VAD
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=600
VAD_SPEECH_PAD_MS=30
VAD_MAX_SPEECH_S=30

# Screenshot (max. Breite in px)
SCREENSHOT_MAX_WIDTH=1920

# Shell-Whitelist für run_command (kommagetrennte Befehls-Präfixe; leer = alles blockiert)
ALLOWED_COMMANDS=
