# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ASR: "local" = whisper.cpp-Server (Default, niedrigste Latenz) | "openrouter"
ASR_BACKEND=local
WHISPER_SERVER_URL=http://127.0.0.1:8080
ASR_LANGUAGE=de

# Modelle
ASR_MODEL=meta/muse-spark-1.3  # nur fuer openrouter-Backend (Audio-faehig)
ACTION_MODEL=google/gemma-4-31b-it

# Audio-Device (leer = Auto-Detect; z. B. "Elgato Wave Neo" oder Index)
AUDIO_DEVICE=

# VAD (Silero v5)
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=350
VAD_SPEECH_PAD_MS=30
VAD_MAX_SPEECH_S=30

# Screenshot (JPEG, max. Breite in px, Qualitaet)
SCREENSHOT_MAX_WIDTH=1280
SCREENSHOT_QUALITY=80

# Shell-Whitelist für run_command (kommagetrennte Befehls-Präfixe; leer = alles blockiert)
ALLOWED_COMMANDS=
